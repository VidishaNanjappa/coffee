PORT=4000

# Neon Postgres. Use the DIRECT (non-pooler) host for both to keep migrations working.
# DATABASE_URL is used by the app, DIRECT_URL by Prisma Migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

JWT_SECRET=replace-with-a-long-random-secret

# Seeded admin account (run `npm run db:seed` after changing these)
ADMIN_EMAIL=admin@coorgcup.in
ADMIN_PASSWORD=change-this-password

FRONTEND_URL=http://localhost:5173

# Payment gateways (optional)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
